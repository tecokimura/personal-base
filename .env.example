DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=personal_base
DB_PORT=5432

# Prisma migrate dev is executed from the host during development,
# so DATABASE_URL points to localhost rather than the Docker service name.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/personal_base?schema=public

SESSION_SECRET=replace-with-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000
STORAGE_LOCAL_PATH=apps/backend/uploads

# デバッグ機能: 開発時のみ true に設定（本番では NODE_ENV=production で強制無効）
DEBUG_LOGIN_ENABLED=false
