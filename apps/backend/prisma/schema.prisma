generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          Int      @id @default(autoincrement())
  tenantCode  String   @unique @db.VarChar(100)
  name        String   @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// isDeleted: 誤登録・無効化のための例外的な論理削除フラグ（退職管理とは分離）
// 在籍状態の正本は Employment.status とする
model Employee {
  id                 Int                  @id @default(autoincrement())
  tenantId           Int
  employeeNumber     String?              @db.VarChar(50)
  fullName           String               @db.VarChar(255)
  displayName        String?              @db.VarChar(255)
  email              String?              @db.VarChar(255)
  birthDate          DateTime?            @db.Date
  photoStorageKey    String?              @db.VarChar(1000)
  profileFreeText    String?
  isDeleted          Boolean              @default(false)
  deletedAt          DateTime?
  updatedBy          Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  userAccount        UserAccount?
  organizationLeaders OrganizationLeader[]
  employments        Employment[]
  workHistories      WorkHistory[]
  qualifications     Qualification[]
  adminSection       EmployeeAdminSection?

  @@unique([tenantId, employeeNumber])
  @@index([tenantId])
  @@index([tenantId, isDeleted])
}

// status: 1=有効, 2=無効
model UserAccount {
  id              Int              @id @default(autoincrement())
  tenantId        Int
  employeeId      Int              @unique
  loginIdentifier String           @db.VarChar(255)
  passwordHash    String           @db.VarChar(255)
  status          Int              @db.SmallInt
  lastLoggedInAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  employee        Employee         @relation(fields: [employeeId], references: [id])
  sessions        Session[]
  roleAssignments RoleAssignment[]
  twoFactorAuth   TwoFactorAuth?

  @@unique([tenantId, employeeId])
  @@unique([tenantId, loginIdentifier])
  @@index([tenantId])
}

model Session {
  id                Int         @id @default(autoincrement())
  tenantId          Int
  userAccountId     Int
  sessionTokenHash  String      @db.VarChar(255)
  expiresAt         DateTime
  revokedAt         DateTime?
  twoFactorVerified Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  userAccount       UserAccount @relation(fields: [userAccountId], references: [id])

  @@unique([sessionTokenHash])
  @@index([tenantId])
  @@index([userAccountId])
  @@index([expiresAt])
}

// employmentType: 1=正社員, 2=契約社員, 3=パートタイム, 4=派遣, 5=業務委託
// status: 1=在職, 2=休職, 3=退職, 9=削除
model Employment {
  id                  Int              @id @default(autoincrement())
  tenantId            Int
  employeeId          Int
  organizationId      Int
  positionMasterId    Int?
  employmentType      Int              @db.SmallInt
  supervisorEmployeeId Int?             @map("managerEmployeeId")
  startDate           DateTime         @db.Date
  endDate             DateTime?        @db.Date
  status              Int              @db.SmallInt
  updatedBy           Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  employee            Employee         @relation(fields: [employeeId], references: [id])
  organization        Organization     @relation(fields: [organizationId], references: [id])
  positionMaster      PositionMaster?  @relation(fields: [positionMasterId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([organizationId])
  @@index([status])
}

model PositionMaster {
  id           Int          @id @default(autoincrement())
  tenantId     Int
  name         String       @db.VarChar(255)
  displayOrder Int          @default(0)
  isActive     Boolean      @default(true)
  updatedBy    Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  employments  Employment[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

// leaderType: 1=部門長, 2=副部門長
// status: 1=有効, 2=終了済み
model Organization {
  id                   Int                  @id @default(autoincrement())
  tenantId             Int
  organizationName     String               @db.VarChar(255)
  organizationCode     String?              @db.VarChar(100)
  parentOrganizationId Int?
  displayOrder         Int                  @default(0)
  isActive             Boolean              @default(true)
  updatedBy            Int?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  parent               Organization?        @relation("OrganizationChildren", fields: [parentOrganizationId], references: [id])
  children             Organization[]       @relation("OrganizationChildren")
  leaders              OrganizationLeader[]
  employments          Employment[]

  @@unique([tenantId, organizationCode])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([parentOrganizationId])
}

// leaderType: 1=部門長, 2=副部門長
// status: 1=有効, 2=終了済み
model OrganizationLeader {
  id              Int          @id @default(autoincrement())
  tenantId        Int
  organizationId  Int
  employeeId      Int
  leaderType      Int          @db.SmallInt
  isPrimaryLeader Boolean      @default(false)
  startDate       DateTime     @db.Date
  endDate         DateTime?    @db.Date
  status          Int          @db.SmallInt
  updatedBy       Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id])
  employee        Employee     @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([organizationId])
  @@index([tenantId, employeeId])
  @@index([status])
}

model LoginHistory {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  userAccountId Int
  employeeId    Int
  loggedInAt    DateTime @default(now())
  ipAddress     String?  @db.VarChar(45)
  userAgent     String?  @db.VarChar(500)

  @@index([tenantId])
  @@index([userAccountId])
  @@index([tenantId, loggedInAt])
}

// actionType: "CREATE" | "UPDATE" | "SOFT_DELETE" | "RESTORE" | "TERMINATE"
// entityType: "Employee" | "Employment" | "Organization" | "RoleAssignment"
model EditHistory {
  id                  Int      @id @default(autoincrement())
  tenantId            Int
  entityType          String   @db.VarChar(100)
  entityId            Int
  actionType          String   @db.VarChar(50)
  changedByEmployeeId Int
  changedAt           DateTime @default(now())
  scopeSummary        String?  @db.VarChar(500)

  @@index([tenantId])
  @@index([tenantId, entityType])
  @@index([tenantId, changedAt])
}

model WorkHistory {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  employeeId    Int
  yearMonthFrom String   @db.VarChar(7)
  yearMonthTo   String?  @db.VarChar(7)
  isCurrent     Boolean  @default(false)
  workSummary   String
  toolsUsed     String?  @db.VarChar(1000)
  roleName      String?  @db.VarChar(255)
  teamSize      Int?
  projectCode   String?  @db.VarChar(100)
  updatedBy     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  employee      Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([tenantId, employeeId])
}

model Qualification {
  id           Int      @id @default(autoincrement())
  tenantId     Int
  employeeId   Int
  name         String   @db.VarChar(255)
  acquiredDate DateTime @db.Date
  note         String?  @db.VarChar(500)
  updatedBy    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  employee     Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([tenantId, employeeId])
}

model EmployeeAdminSection {
  id                 Int      @id @default(autoincrement())
  tenantId           Int
  employeeId         Int      @unique
  evaluation         String?  @db.VarChar(500)
  grade              String?  @db.VarChar(255)
  joiningReason      String?
  employmentCategory String?  @db.VarChar(255)
  salaryBand         String?  @db.VarChar(255)
  specialNotes       String?
  updatedBy          Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  employee           Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([tenantId, employeeId])
}

// roleType: 1=HR_ADMIN, 2=MANAGER, 3=ORG_ADMIN, 4=EXECUTIVE_VIEWER, 5=EMPLOYEE
// scopeType: 1=SELF, 2=ORGANIZATION, 3=ORGANIZATION_TREE, 4=TENANT_ALL
model RoleAssignment {
  id            Int         @id @default(autoincrement())
  tenantId      Int
  userAccountId Int
  roleType      Int         @db.SmallInt
  scopeType     Int         @db.SmallInt
  scopeId       Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id])

  @@index([tenantId])
  @@index([userAccountId])
  @@index([roleType])
  @@index([scopeType, scopeId])
}

// twoFactorPolicy: 1=任意, 2=必須
model TenantSetting {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @unique
  twoFactorPolicy Int      @default(1) @db.SmallInt
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TwoFactorAuth {
  id               Int         @id @default(autoincrement())
  tenantId         Int
  userAccountId    Int         @unique
  totpSecret       String      @db.VarChar(255)
  backupCodeHashes String[]
  twoFactorEnabled Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  userAccount      UserAccount @relation(fields: [userAccountId], references: [id])

  @@index([tenantId])
}
