generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// enrollmentStatus: 10=在職, 20=休職, 30=退職
// isDeleted: 誤登録・無効化のための例外的な論理削除フラグ（退職管理とは分離）
model Employee {
  id               Int          @id @default(autoincrement())
  tenantId         Int
  enrollmentStatus Int          @db.SmallInt
  isDeleted        Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  userAccount      UserAccount?

  @@index([tenantId])
  @@index([enrollmentStatus])
}

// status: 1=有効, 2=無効
model UserAccount {
  id              Int              @id @default(autoincrement())
  tenantId        Int
  employeeId      Int              @unique
  loginIdentifier String           @db.VarChar(255)
  passwordHash    String           @db.VarChar(255)
  status          Int              @db.SmallInt
  lastLoggedInAt  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  employee        Employee         @relation(fields: [employeeId], references: [id])
  sessions        Session[]
  roleAssignments RoleAssignment[]

  @@unique([tenantId, employeeId])
  @@unique([tenantId, loginIdentifier])
  @@index([tenantId])
}

model Session {
  id               Int         @id @default(autoincrement())
  tenantId         Int
  userAccountId    Int
  sessionTokenHash String      @db.VarChar(255)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  userAccount      UserAccount @relation(fields: [userAccountId], references: [id])

  @@unique([sessionTokenHash])
  @@index([tenantId])
  @@index([userAccountId])
  @@index([expiresAt])
}

// leaderType: 1=部門長, 2=副部門長
// status: 1=有効, 2=終了済み
model Organization {
  id                   Int                  @id @default(autoincrement())
  tenantId             Int
  organizationName     String               @db.VarChar(255)
  organizationCode     String?              @db.VarChar(100)
  parentOrganizationId Int?
  displayOrder         Int                  @default(0)
  isActive             Boolean              @default(true)
  updatedBy            Int?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  parent               Organization?        @relation("OrganizationChildren", fields: [parentOrganizationId], references: [id])
  children             Organization[]       @relation("OrganizationChildren")
  leaders              OrganizationLeader[]

  @@unique([tenantId, organizationCode])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([parentOrganizationId])
}

// leaderType: 1=部門長, 2=副部門長
// status: 1=有効, 2=終了済み
model OrganizationLeader {
  id              Int          @id @default(autoincrement())
  tenantId        Int
  organizationId  Int
  employeeId      Int
  leaderType      Int          @db.SmallInt
  isPrimaryLeader Boolean      @default(false)
  startDate       DateTime     @db.Date
  endDate         DateTime?    @db.Date
  status          Int          @db.SmallInt
  updatedBy       Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id])

  @@index([tenantId])
  @@index([organizationId])
  @@index([tenantId, employeeId])
  @@index([status])
}

// roleType: 1=HR_ADMIN, 2=MANAGER, 3=ORG_ADMIN, 4=EXECUTIVE_VIEWER, 5=EMPLOYEE
// scopeType: 1=SELF, 2=ORGANIZATION, 3=ORGANIZATION_TREE, 4=TENANT_ALL
model RoleAssignment {
  id            Int         @id @default(autoincrement())
  tenantId      Int
  userAccountId Int
  roleType      Int         @db.SmallInt
  scopeType     Int         @db.SmallInt
  scopeId       Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id])

  @@index([tenantId])
  @@index([userAccountId])
  @@index([roleType])
  @@index([scopeType, scopeId])
}
